require 'json'

default_platform(:ios)

platform :ios do
  desc 'Build a signed IPA. Usage: bundle exec fastlane ios build tenant:athena environment:production'
  lane :build do |options|
    tenant_key = options[:tenant]
    deployment_environment = options[:environment] || 'development'
    tenants = JSON.parse(File.read(File.expand_path('../tenants/tenants.json', __dir__)))
    tenant = tenants[tenant_key]
    UI.user_error!("Unknown tenant: #{tenant_key}") unless tenant
    environment_config = tenant.fetch('environments').fetch(deployment_environment)

    app_identifier = "#{tenant.fetch('bundleId')}#{environment_config.fetch('bundleIdSuffix')}"
    app_name = "#{tenant.fetch('appName')}#{environment_config.fetch('displayNameSuffix')}"
    export_method = environment_config.fetch('iosExportMethod')
    match_type = { 'app-store' => 'appstore', 'ad-hoc' => 'adhoc', 'development' => 'development' }.fetch(export_method)
    match(
      type: match_type,
      app_identifier: app_identifier,
      readonly: true
    )

    workspace = Dir[File.join(__dir__, '..', 'platforms', 'ios', '*.xcworkspace')].first
    UI.user_error!('Cordova iOS workspace was not generated.') unless workspace

    build_app(
      workspace: workspace,
      scheme: app_name,
      configuration: 'Release',
      export_method: export_method,
      output_directory: File.join(__dir__, '..', 'artifacts', tenant_key, deployment_environment, 'ios'),
      output_name: "#{tenant_key}-#{deployment_environment}.ipa",
      clean: true
    )
  end
end
