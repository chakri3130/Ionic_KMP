require 'json'

default_platform(:ios)

platform :ios do
  desc 'Build a signed IPA for the selected tenant. Usage: bundle exec fastlane ios build tenant:athena'
  lane :build do |options|
    tenant_key = options[:tenant]
    tenants = JSON.parse(File.read(File.expand_path('../tenants/tenants.json', __dir__)))
    tenant = tenants[tenant_key]
    UI.user_error!("Unknown tenant: #{tenant_key}") unless tenant

    app_identifier = tenant.fetch('bundleId')
    app_name = tenant.fetch('appName')
    match(
      type: ENV.fetch('IOS_EXPORT_METHOD', 'app-store'),
      app_identifier: app_identifier,
      readonly: true
    )

    workspace = Dir[File.join(__dir__, '..', 'platforms', 'ios', '*.xcworkspace')].first
    UI.user_error!('Cordova iOS workspace was not generated.') unless workspace

    build_app(
      workspace: workspace,
      scheme: app_name,
      configuration: 'Release',
      export_method: ENV.fetch('IOS_EXPORT_METHOD', 'app-store'),
      output_directory: File.join(__dir__, '..', 'artifacts', tenant_key, 'ios'),
      output_name: "#{tenant_key}.ipa",
      clean: true
    )
  end
end
